# Manejo de finales de línea
* text=auto

# Archivos Python
*.py text eol=lf

# Archivos web
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf

# Archivos de configuración
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Archivos binarios
*.xlsx binary
*.xls binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
